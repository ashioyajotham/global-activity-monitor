{
  "name": "global-activity-monitor",
  "version": "5.0.0",
  "description": "Evidence-backed news monitor with provisional severity and reviewed local classification",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "cleanup": "node -e \"require('./db').init(); require('./db').cleanup(30); require('./db').close();\"",
    "test": "node --test tests/*.test.js",
    "replay": "node scripts/replay.js",
    "review:freeze": "node scripts/freeze-review.js",
    "model:parity": "node scripts/model-parity.js",
    "model:promote": "node scripts/promote-model.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "4.22.1",
    "rss-parser": "^3.13.0",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
